# Aplicacao
PORT=4187
NODE_ENV=production
APP_URL=https://businessbarber.com.br

# Armazenamento: use json somente para demonstracao local. Para cliente real use supabase.
STORAGE_PROVIDER=json
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STATE_ID=businessbarber-production

# Usuarios iniciais: configure no Render antes do primeiro login.
# Nunca compartilhe estas senhas nem as salve no GitHub.
ADMIN_EMAIL=
ADMIN_PASSWORD=
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_NAME=Dono da Barbearia
OWNER_BARBERSHOP_ID=shop-alpha
RESET_BOOTSTRAP_PASSWORD=false

# Modo demo opcional, apenas para apresentacoes sem dados reais.
DEMO_MODE=false
DEMO_EMAIL=demo@businessbarber.local
DEMO_PASSWORD=
ALLOW_LEGACY_AUTH=false

# WhatsApp Cloud API - fallback global da plataforma.
# Para multi-barbearia, salve Phone Number ID, token, App Secret e Verify Token no painel de cada barbearia.
WHATSAPP_PROVIDER=whatsapp_cloud_api
WHATSAPP_MODE=sandbox
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_DEFAULT_TEMPLATE=retorno_cliente_sumido
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR

# Meta Embedded Signup - conexao automatica do WhatsApp por barbearia.
# Crie uma configuracao de Embedded Signup no app da Meta e use o callback abaixo:
# https://businessbarber.com.br/api/webhooks/whatsapp
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_BUSINESS_ID=
META_SYSTEM_USER_ACCESS_TOKEN=

# Pix: mantem operacao manual ate integrar provedor real.
PIX_PROVIDER=manual_pix
PIX_MODE=manual
PIX_KEY=
PIX_DEPOSIT_AMOUNT=15
